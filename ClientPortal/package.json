{
  "name": "client-portal",
  "version": "1.0.0",
  "description": "Client Portal happy-path tests (Playwright + TypeScript, Page Object Model)",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:bulk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-bulk.ps1",
    "export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export.ps1",
    "export:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export.ps1 -Offline",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "codegen": "playwright codegen"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
